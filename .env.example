# Environment variables for the Playwright E2E tests (playwright/).
# Playwright does not read .env: export these in your shell (see playwright/README.md).
# All are optional; the specs fall back to the defaults noted below.

# Throwaway ARC-76 account used by the read-only sign-in checks
# (default: testtesttest@biatec.io for both).
AUTH_TEST_EMAIL=
AUTH_TEST_PASSWORD=

# Funded mainnet account for the review-dialog checks in add-liquidity-mid-price.spec.ts
# (those assertions are skipped when no password is set).
LIQUIDITY_TEST_EMAIL=
LIQUIDITY_TEST_PASSWORD=

# Funded testnet account for testnet-lifecycle.spec.ts (skipped when no password is set).
TESTNET_TEST_EMAIL=
TESTNET_TEST_PASSWORD=

# Point Playwright at an already-running server instead of building and previewing on :4173.
# PLAYWRIGHT_BASE_URL=http://localhost:5173

# Never commit a .env file with real credentials (it is already in .gitignore).
