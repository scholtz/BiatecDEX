# Help screenshots are NOT generated here anymore — they used to require installing
# a full Chromium + OS deps and booting a dev server on every single deploy, which
# was the slowest part of this build. They're now generated by the separate
# docker/Dockerfile.docs image (built manually/on a schedule via
# .github/workflows/generate-screenshots.yml) and just copied in below.
FROM scholtz2/biatec-dex-docs:latest AS docs

FROM node:24 AS build
WORKDIR /src
RUN apt update \
  && apt dist-upgrade -y \
  && apt-get clean autoclean \
  && apt-get autoremove --yes \
  && rm -rf /var/lib/{apt,dpkg,cache,log}/ \
  && npm install -g npm@latest
COPY package-lock.json package-lock.json
COPY package.json package.json
RUN npm ci
COPY . .
# Generate fresh localised help text from help-bodies.mjs into all 10 locale JSON files
RUN node scripts/generate-help-locales.mjs
# Screenshots produced by docker/Dockerfile.docs — bundled by the `vite build` step
# below as static assets, same as when they were generated in this stage.
COPY --from=docs /help-screenshots ./public/help-screenshots
RUN npm run build
RUN cd /src/dist && ls

FROM nginxinc/nginx-unprivileged:latest
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN apt update && apt dist-upgrade -y && apt install -y bc mc wget telnet git curl iotop atop vim && apt-get clean autoclean && apt-get autoremove --yes && rm -rf /var/lib/{apt,dpkg,cache,log}/
RUN mkdir /app
COPY docker/default.conf /etc/nginx/conf.d/default.conf
RUN chown nginx:nginx /etc/nginx/conf.d -R
RUN chmod 0600 /etc/nginx/conf.d -R
RUN chmod 0700 /etc/nginx/conf.d
USER nginx
WORKDIR /app
COPY --from=build /src/dist .
RUN pwd && ls
